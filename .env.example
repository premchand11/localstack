# After `make up`, prefer copying .generated/endpoints.env
# Names come from config.yml (buckets, queues, topics, tables, secrets).

AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true

# Example aliases currently in config.yml:
DATFILE_UPLOAD_S3_BUCKET=dat-uploads
DATFILE_UPLOAD_VALIDATION_QUEUE_URL=http://localhost:4566/000000000000/dat-processing
DATFILE_UPLOAD_SUBMISSION_QUEUE_URL=http://localhost:4566/000000000000/dat-processing-submission
DATFILE_UPLOAD_REPORT_QUEUE_URL=http://localhost:4566/000000000000/dat-processing-report
